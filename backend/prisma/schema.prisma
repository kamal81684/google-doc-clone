generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// General access for a document's link ("Anyone with the link"), on top of per-user permissions
enum LinkAccess {
    RESTRICTED
    VIEWER
    EDITOR
}

enum PermissionRole {
    VIEWER
    EDITOR
}

model DocumentPermission {
    id         String @id @default(cuid())

    documentId String
    userId     String

    role PermissionRole

    document Document @relation(fields:[documentId], references:[id], onDelete: Cascade)

    user User @relation(fields:[userId], references:[id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([documentId, userId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  avatar    String?
  documents Document[]
  folders   Folder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sharedDocuments DocumentPermission[]
  conversations   Conversation[]
}

model Document {
  id String @id @default(cuid())
  
  title String @default("Untitled Document")

  content Json?

  ydocState Bytes?

  ownerId String

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  permissions DocumentPermission[]

  // RESTRICTED = only the owner and people it's shared with; VIEWER/EDITOR = anyone with the link,
  // including visitors who aren't signed in
  linkAccess LinkAccess @default(RESTRICTED)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Hash of the text last embedded into DocumentChunk; null = never indexed
  indexedHash String?
  indexedAt   DateTime?
  chunks      DocumentChunk[]

  @@index([ownerId, folderId])
}

model Folder {
  id          String  @id @default(cuid())
  name        String
  description String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
}

// Text chunks of a document with their embedding, used for "chat with your docs".
// The embedding column is managed with raw SQL (pgvector), Prisma can't type it.
model DocumentChunk {
  id         String @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
}

// "Chat with your docs" history: one row per chat thread
model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // First question, trimmed; shown in the history list
  title    String
  messages ConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

enum ConversationRole {
  USER
  ASSISTANT
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ConversationRole
  content String
  // Assistant turns: the excerpts it could cite, [{ index, documentId, title }]
  sources Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
