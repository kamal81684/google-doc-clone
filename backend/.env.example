PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/google_docs_clone"
JWT_SECRET="your-secret-key"

# Optional — enables Google Sign-In (must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=""

# LLM — any OpenAI-compatible endpoint (chat with your docs, Organize with AI)
#   Groq:      https://api.groq.com/openai/v1   model e.g. openai/gpt-oss-120b
#   OpenAI:    https://api.openai.com/v1        model e.g. gpt-5-mini
#   LiteLLM:   http://localhost:4000/v1         model = a model_name from your LiteLLM config
#   OpenRouter: https://openrouter.ai/api/v1    model e.g. openai/gpt-oss-120b
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""
LLM_MODEL="openai/gpt-oss-120b"
LLM_CHAT_MODEL=""                  # optional: override LLM_MODEL for chat
LLM_ORGANIZE_MODEL=""              # optional: override LLM_MODEL for organize (needs JSON-schema support)
LLM_REASONING="true"               # set to false for models that reject reasoning_effort
LLM_CHAT_REASONING=""              # optional: off (default, fastest first token) | low | medium | high
LLM_MAX_TOKENS_PARAM=""            # optional: max_tokens | max_completion_tokens (auto: max_tokens for Sarvam)
LLM_MAX_OUTPUT_TOKENS=""           # optional: cap output tokens to your plan's limit

# Other AI services
VOYAGE_API_KEY=""                  # optional: semantic (vector) search
SARVAM_API_KEY=""                  # optional: Sarvam Prism, confidence-scored folder assignment
                                   #   (falls back to LLM_API_KEY when LLM_BASE_URL is Sarvam's)

# SMTP — emails people when a document is shared with them ("Notify people").
# Leave SMTP_HOST empty to disable. Gmail: smtp.gmail.com, port 465, an App Password as SMTP_PASS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""                     # optional: true/false (default: true only for port 465)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Docs <no-reply@example.com>"  # optional: defaults to SMTP_USER
APP_URL="http://localhost:3000"    # frontend URL used for links in emails
